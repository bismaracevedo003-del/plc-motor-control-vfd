# Optional real-mode configuration for the motor/VFD station.
# Copy to .env and export the variables you need. .env is gitignored.
# Leave MODE=simulation to keep the existing simulator and tests unchanged.
MODE=simulation
REAL_STRICT=true
LOG_LEVEL=INFO

# Writes are disabled by default; the adapter is read-only.
ALLOW_WRITES=false

# Required when MODE=real (replace placeholders with real plant values).
S7_HOST=<PLC_IP_ADDRESS>
S7_PORT=102
S7_RACK=<RACK_NUMBER>
S7_SLOT=<SLOT_NUMBER>

# Optional partial override of the DB20 address map (JSON, tag -> AREA:byte[.bit]).
# S7_ADDRESS_MAP={"StartCmd":"DB20:0.0","ActualFrequency_Hz":"DB20:8"}
